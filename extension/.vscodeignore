# ── Exclude the entire monorepo parent (critical for workspaces) ──
../**

# ── Dev / config files inside extension/ ─────────────────────────
.vscode/**
.vscode-test/**
node_modules/**
src/**
tsconfig.json
.gitignore
**/*.map
**/*.ts

# ── Re-include what the VSIX actually needs ───────────────────────
!out/**
!media/**
!package.json
